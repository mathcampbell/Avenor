# ------------------------------------------------------------
# Unreal Engine generated directories
# ------------------------------------------------------------

**/Binaries/**
**/DerivedDataCache/**
**/Intermediate/**
**/Saved/**

# ------------------------------------------------------------
# Generated World Partition / HLOD data
#
# Keep authored Unreal content in Git LFS, but ignore the disposable
# actor shards and HLOD products created for generated terrain maps.
# ------------------------------------------------------------

**/Content/**/HLOD/**
**/Content/**/HLODs/**
**/Content/**/*_HLOD_*.uasset
**/Content/**/Avenor_WorldNew/**
**/Content/**/Avenor_WorldNew*.uasset
**/Content/**/Avenor_WorldNew*.umap
**/Content/**/MPD_AvenorDefinition.uasset

# Generated directories inside plugins
**/Plugins/**/Binaries/**
**/Plugins/**/Intermediate/**

# ------------------------------------------------------------
# Visual Studio and IDE-generated files
# ------------------------------------------------------------

**/.vs/
**/.vscode/
**/.idea/
*.sln
*.slnx
*.code-workspace
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# ------------------------------------------------------------
# Compiled object and library files
# ------------------------------------------------------------

*.slo
*.lo
*.o
*.obj
*.gch
*.pch

*.so
*.dylib
*.dll

*.lai
*.la
*.a
*.lib

# ------------------------------------------------------------
# Executables and packaged applications
# ------------------------------------------------------------

*.exe
*.out
*.app
*.ipa

# ------------------------------------------------------------
# Build directory
#
# Ignore generated build output, but retain source-controlled
# icons and PakBlacklist configuration files.
# ------------------------------------------------------------

**/Build/**

!**/Build/
!**/Build/**/*.ico
!**/Build/**/PakBlacklist*.txt

# ------------------------------------------------------------
# Generated map build data
# ------------------------------------------------------------

*_BuiltData.uasset

# ------------------------------------------------------------
# Optional source artwork exclusions
# ------------------------------------------------------------

**/SourceArt/**/*.png
**/SourceArt/**/*.tga

# ------------------------------------------------------------
# Operating-system clutter
# ------------------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini
